Optimal Code: we know that this array is sorted and we have to perform search and whenever we performed search in a sorted section then algorithm -> Binary Search
code: class Solution {
    public int first(int[] arr,int target)
    {
        int n = arr.length,ans=-1,low=0,high=n-1;
        while(low<=high)
        {
            int mid = (low+high)/2;
            if(arr[mid]==target)
            {
                ans=mid;
                high=mid-1;
            }
            else if(arr[mid]<target)
            {
                low=mid+1;
            }
            else
            {
                high=mid-1;
            }
        }
        return ans;
    }
    public int second(int[] arr,int target)
    {
        int n = arr.length,ans=-1,low=0,high=n-1;
        while(low<=high)
        {
            int mid = (low+high)/2;
            if(arr[mid]==target)
            {
                ans=mid;
                low=mid+1;
            }
            else if(arr[mid]<target)
            {
                low=mid+1;
            }
            else
            {
                high=mid-1;
            }
        }
        return ans;
    }
    public int[] searchRange(int[] nums, int target) {
        int ans1=first(nums,target);
        int ans2=second(nums,target);
        return new int[] {ans1,ans2};
    }
}