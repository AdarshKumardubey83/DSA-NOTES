public class practice{
    static int floor(int[] arr,int target)
    {
        int n=arr.length,ans=-1,low=0,high=n-1;
        while(low<=high)
        {
            int mid = (low+high)/2;
            if(arr[mid]<=target)
            {
                ans=arr[mid];
                low=mid+1;
            }
            else
            {
                high=mid-1;
            }
        }
        return ans;
    }
    static int ceil(int[] arr,int target)
    {
        int n=arr.length,ans=-1,low=0,high=n-1;
        while(low<=high)
        {
            int mid = (low+high)/2;
            if(arr[mid]>=target)
            {
                ans=arr[mid];
                high=mid-1;
            }
            else
            {
                low=mid+1;
            }
        }
        return ans;
    }
    public static void main(String[] args) {
        int[] arr={10,20,30,40,50};
        int target=25;
        int first=floor(arr,target);
        int second=ceil(arr,target);
        System.out.println(first + " " + second);
    }
}  

