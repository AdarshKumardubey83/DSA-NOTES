1. Minimum number of Coins
==========================

code: class Solution {
    public int minCoins(int n) {
        // code here
        int[] arr = {10,5,2,1};
        int cnt = 0;
        int i =0;
        while(n>0)
        {
            cnt+=n/arr[i];
            n%=arr[i];
            i++;
        }
        return cnt;
    }
}

2. Shop in Candy Store
========================

code: class Solution {
    public ArrayList<Integer> candyStore(int prices[], int k) {
        // code here
        ArrayList<Integer> ans = new ArrayList<>();
        int n = prices.length;
        Arrays.sort(prices);

        int i = 0 , j = n-1;
        int cost=0;
        while(i<=j)
        {
            cost+=prices[i];
            j-=k;
            i++;
        }
        ans.add(cost);
        cost = 0;

        i=n-1;
        j=0;
        
        while(i>=j)
        {
            cost+=prices[i];
            j+=k;
            i--;
        }

        ans.add(cost);

        return ans;
    }
}

3. Assign Mice Holes
========================

code: class Solution {
    public int assignMiceHoles(int[] mices, int[] holes) {
        // code here
        Arrays.sort(mices);
        Arrays.sort(holes);

        int n = mices.length;
        int ans = 0;

        for(int i=0;i<n;i++)
        {
            ans= Math.max(ans,Math.abs(mices[i]-holes[i]));
        }
        return ans;
    }
}

4. Minimum rotations to unlock a circular lock
==============================================

code: class Solution {
    public long rotationCount(long R, long D) {
        // code here
        long ans = 0;
        while(R>0 || D>0)
        {
            long r = R%10;
            long d = D%10;
            ans+=Math.min(Math.abs(r-d),10-Math.abs(r-d));
            R/=10;
            D/=10;
        }
        return ans;
    }
}

5.  N meetings in one room
===========================

code: class Solution {
    public int maxMeetings(int[] start, int[] end) {
        // code here
        List<int[]> meetings = new ArrayList<>();
        int n = start.length;

        for(int i=0;i<n;i++)
        {
            meetings.add(new int[]{end[i],start[i]});
        }

        meetings.sort(Comparator.comparingInt(a -> a[0]));

        int lastMeeting = -1;
        int totalMeeting = 0;

        for(int[] m: meetings){
            if(m[1]>lastMeeting)
            {
                totalMeeting++;
                lastMeeting = m[0];
            }
        }

        return totalMeeting;
        
    }
}


