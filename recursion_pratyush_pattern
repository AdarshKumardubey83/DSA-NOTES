Subsets
=======

code: class Solution {
    void f(int i,int n, List<List<Integer>> ans, ArrayList<Integer> list,int[] nums)
    {
        if(i==n)
        {
            ans.add(new ArrayList<>(list));
            return;
        }
        list.add(nums[i]);
        f(i+1,n,ans,list,nums);
        list.remove(list.size()-1);
        f(i+1,n,ans,list,nums);
    }
    public List<List<Integer>> subsets(int[] nums) {
        List<List<Integer>> ans = new ArrayList<>();
        ArrayList<Integer> list = new ArrayList<>();
        int n = nums.length;
        f(0,n,ans,list,nums);
        return ans;
    }
}

Nth Fibonacci Number
====================

int fib(int n) {
    if(n == 0) return 0;    
    if(n == 1) return 1;     => Base case  

    int ans1 = fib(n - 1);
    int ans2 = fib(n - 2);   => Trust/Vishwas    

    return ans1 + ans2;  => jod ke apna answer bana liya
}


Palindrome String
=================

boolean fun(String s , int low , int high ) {
    int len = high - low + 1;
    if(len ==0 || len==1) return true;  => Base case

    if(s.charAt(low) != s.charAt(high)) return false;   

    return fun(s , low + 1 , high - 1);  => Trust/Vishwas
}

Sum of Digits
=================

int fun(int n) {
    
    if(n==0) return 0;  => Base case

    int last = n%10;   => last digit
    int ans = fun(n/10);  => Trust/Vishwas

    return ans + last;  => jod ke apna answer bana liya
}

