boolean isSorted(int[] arr, int i) {
    if(i == arr.length - 1 || i==n) return true;  => Base case

    if(arr[i] > arr[i + 1]) return false;  => Trust/Vishwas

    return isSorted(arr, i + 1);  => chote problem me tod ke solve kar rahe hai
