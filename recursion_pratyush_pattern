Subsets
=======

code: class Solution {
    void f(int i,int n, List<List<Integer>> ans, ArrayList<Integer> list,int[] nums)
    {
        if(i==n)
        {
            ans.add(new ArrayList<>(list));
            return;
        }
        list.add(nums[i]);
        f(i+1,n,ans,list,nums);
        list.remove(list.size()-1);
        f(i+1,n,ans,list,nums);
    }
    public List<List<Integer>> subsets(int[] nums) {
        List<List<Integer>> ans = new ArrayList<>();
        ArrayList<Integer> list = new ArrayList<>();
        int n = nums.length;
        f(0,n,ans,list,nums);
        return ans;
    }
}

