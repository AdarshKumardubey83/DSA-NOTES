int func(int[] arr,int n){
    if(n==1) {
        return arr[0];
    }
    int last = arr[n-1];             => base case hai aur problem ko chote problem me tod ke solve kar rahe hai, us type ka template hai ye
    int ans = func(arr,n-1);
    return Math.max(ans,last);
}

