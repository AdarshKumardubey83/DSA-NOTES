Now Striver Approach : ek global carry maintain karna hai aur carry ke liye modulus karo kyuki , adhik se adhik single digit numbers ka sum 18 hoga aur hume modulus karne pe mil jayega aur carry ke liye quotient nikalo sum/10 , har baar 1 hi quotient aayega kyuki max sum  can be 18 and 18/10 =1 , toh har baar maintain hoga , at last agar carry mein 1 reh jata hai toh usko last mein resulting list mein add karna hai

code: class Solution {
    public ListNode addTwoNumbers(ListNode l1, ListNode l2) {
        ListNode dummy = new ListNode(0);
        ListNode t1 = l1, t2 = l2, curr = dummy;
        int carry = 0;
        while(t1!=null || t2!=null)
        {
            int sum = carry;
            if(t1!=null) sum+=t1.val;
            if(t2!=null) sum+=t2.val;
            curr.next = new ListNode(sum%10);
            curr=curr.next;
            carry=sum/10;
            if(t1!=null) t1=t1.next;
            if(t2!=null) t2=t2.next;
        }
        if(carry!=0)
        {
            curr.next=new ListNode(carry);
        }
        return dummy.next;
    }
}

