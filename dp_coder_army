bottom-up : bottom-up mein hum reverse se start karte hai 0 se

code: class Solution {
    public int rob(int[] nums) {
        //bottom up 
        //pehle base case bharo
        
        int n = nums.length;
        if(n==1) return nums[0];
        if(n==2) return Math.max(nums[0],nums[1]);
        int[] dp = new int[n];
        dp[0] = nums[0];
        dp[1] = Math.max(nums[0],nums[1]);

        for(int i=2;i<n;i++)
        {
            dp[i] =  Math.max(nums[i]+dp[i-2],dp[i-1]);
        }

        return dp[n-1];
    }
}

