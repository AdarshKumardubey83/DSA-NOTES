code: import java.util.*;
public class practice{
    static int fib(int n,int[] dp)
    {
        if(n<=1) return n;
        if(dp[n]!=-1) return dp[n];
        return dp[n]= fib(n-1,dp)+fib(n-2,dp);
    }
    public static void main(String[] args) {
        int n = 46;
        int[] dp = new int[n+1];
        Arrays.fill(dp,-1);
        System.out.println(fib(n,dp));
    }
}

