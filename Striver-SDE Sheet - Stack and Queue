Brute Force Approach: jo jaisa dikh raha hai same wahi logic hai , window banao aur maximum nikal ke array mein insert kar do.

code: class Solution {
    public int[] maxSlidingWindow(int[] nums, int k) {
        int n = nums.length;
        int[] ans = new int[n-k+1];
        for(int i=0;i<=n-k;i++)
        {
            int max = Integer.MIN_VALUE;
            for(int j=i;j<i+k;j++)
            {
                max = Math.max(max,nums[j]);
            }
            ans[i] = max;
        }
        return ans;
    }
}

