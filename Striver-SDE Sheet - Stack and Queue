2)Implementation of Queue using Arrays
======================================

Start and end are maintaining your start and end of the queue. currSize is maintaining the current size of the queue. If currSize==size then queue is full, if currSize==0 then queue is empty.
Start aur end ke bich mein mera queue hai

public class practice{
    int size = 10;
    int[] queue = new int[size];
    int start = -1, end = -1, currSize = 0;

    void push(int x){
        if(currSize==size){
            System.out.println("Queue is full");
            return;
        }
        else if(currSize==0){
            start = 0;
            end = 0;
        }
        else{
            end = (end+1)%size; // here this formula is used to make the array circular, so that we can use the empty space in the front of the array when we pop the elements from the front of the queue.
        }

        queue[end]=x;
        currSize+=1;

    }

    int pop(){
        if(currSize==0){
            System.out.println("Queue is Empty");
            return -1;
        }
        int el = queue[start];
        if(currSize==1){
            start=-1;
            end=-1;
        }
        else{
            start=(start+1)%size; // here this formula is used to make the array circular, so that we can use the empty space in the front of the array when we pop the elements from the front of the queue.
        }
        currSize-=1;
        return el;
    }

    int top(){
        if(currSize==0){
            System.out.println("No element in Queue");
            return -1;
        }
        return queue[start];
    }

    int size(){
        return currSize;
    }

    public static void main(String[] args) {
        practice q = new practice();
        q.push(10);
        q.push(20);
        System.out.println(q.top());
    }
}

