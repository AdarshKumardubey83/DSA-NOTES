code:class Solution {
    public int subarraySum(int[] nums, int k) {
        HashMap<Integer,Integer> map=new HashMap<>();
        int count=0,prefsum=0,n=nums.length;
        map.put(0,1);
        for(int i=0;i<n;i++)
        {
            prefsum+=nums[i];
            int back=prefsum-k;
            if(map.containsKey(back))
            {
                count+=map.get(back);
            }
            map.put(prefsum,map.getOrDefault(prefsum,0)+1);
        }
        return count;
    }
}