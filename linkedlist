Code: class Solution {
    public DLLNode reverseDLL(DLLNode head) {
        DLLNode current=head,last=null;
        if(head==null || head.next==null) { return head; }
        while(current!=null)
        {
            last=current.prev;
            current.prev=current.next;
            current.next=last;
            current=current.prev;
        }
        return last.prev;
    }
}

