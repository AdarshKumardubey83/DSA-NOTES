Fixed Template to solve mirror/symmetrical type of pattern questions
====================================================================

Same Tree
=========

code: class Solution {
    boolean fun(TreeNode p , TreeNode q)
    {
        if(p==null && q==null) return true;
        if(p==null || q==null) return false;
        if(p.val!=q.val) return false;
        boolean left = fun(p.left,q.left);
        boolean right = fun(p.right,q.right);
        if(left==true && right==true) return true;
        else return false; 
    }
    public boolean isSameTree(TreeNode p, TreeNode q) {
        return fun(p,q);
    }
}

Symmetric Tree
==============

code: class Solution {
    boolean fnc(TreeNode p, TreeNode q)
    {
        if(p==null && q==null) return true;
        if(p==null || q==null) return false;
        if(p.val!=q.val) return false;
        boolean first = fnc(p.left,q.right);
        boolean second = fnc(p.right,q.left);
        if(first==true && second==true) return true;
        else return false;

    }
    public boolean isSymmetric(TreeNode root) {
        if(root==null) return true;
        return fnc(root.left,root.right);
    }
}

Invert Binary Tree
==================

code: class Solution {
    void fun(TreeNode root)
    {
        if(root==null) return;
        TreeNode temp = root.left;
        root.left = root.right;
        root.right = temp;
        fun(root.left);
        fun(root.right);
        return;
    }
    public TreeNode invertTree(TreeNode root) {
        fun(root);
        return root;
    }
}

